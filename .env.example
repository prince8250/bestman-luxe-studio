# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_ values are visible in the browser. Everything else is server-only.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# e.g. http://localhost:3000 in development
NEXT_PUBLIC_SITE_URL=
# Supabase secret (service-role) key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Needed by later specs (optional until then) ---
# Spec 20: bearer token for the studio PC backup script (32+ characters)
BACKUP_EXPORT_TOKEN=
# Spec 22: bearer token for the weekly GitHub Actions backup (32+ characters)
BACKUP_WEBHOOK_TOKEN=
# Spec 18 (Arkesel): console (log only), sandbox (Arkesel test mode: listed in
# the Arkesel history, never delivered or billed), or live
SMS_MODE=console
# Arkesel dashboard -> SMS API -> API key (sandbox and live only)
SMS_API_KEY=
# Approved Arkesel sender ID, up to 11 characters (sandbox and live only)
SMS_SENDER_ID=
# Spec 34: Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Spec 19: protects scheduled job endpoints (32+ characters)
CRON_SECRET=
